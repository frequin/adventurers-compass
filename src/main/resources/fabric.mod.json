{
  "schemaVersion": 1,
  "id": "adventurerscompass",
  "version": "${version}",

  "name": "Adventurer's Compass",
  "description": "Search for and locate structures anywhere in the world. Based on Explorer's Compass by ChaosTheDude.",
  "authors": [
    "Florent Requin"
  ],
  "contributors": [
    "ChaosTheDude (original Explorer's Compass)"
  ],
  "contact": {
    "homepage": "https://github.com/frequin/adventurers-compass",
    "sources": "https://github.com/frequin/adventurers-compass",
    "issues": "https://github.com/frequin/adventurers-compass/issues"
  },

  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/adventurerscompass/icon.png",

  "accessWidener": "adventurerscompass.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.frequin.adventurerscompass.AdventurersCompass"
    ],
    "client": [
      "io.github.frequin.adventurerscompass.AdventurersCompassClient"
    ]
  },
  "mixins": [
    "adventurerscompass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}"
  },
  "suggests": {
    "naturescompass": "*"
  }
}
